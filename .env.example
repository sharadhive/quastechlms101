# ── Database (MySQL 8) ─────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/quastech"

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Adapters (development = zero third-party, per SRS Ch. 9) ──────
MAIL_DRIVER=console            # console (dev, emails go to Outbox table) | smtp (real email)
STORAGE_DRIVER=local           # local   | s3   (post-completion: Cloudflare R2)
LOCAL_STORAGE_PATH=./storage

# ── Post-completion placeholders (leave empty during development) ─
# For Gmail: host smtp.gmail.com, port 587, user = full gmail address,
# pass = 16-char Google App Password (myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ZOOM_ACCOUNT_ID=

# ── Jobs ──────────────────────────────────────────────────────────
CRON_KEY="change-me-random-string"   # protects /api/cron/process (cPanel path)

# ── App ───────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── SmartAccess LMS API (public, no auth — populates registration dropdowns) ─
SMARTACCESS_API_URL=https://smartaccess.in/api/lms
