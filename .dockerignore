# Dependencies (installed inside the image)
node_modules

# Next.js build output (built inside the image)
.next

# Local env files — secrets must be injected at runtime via docker-compose / env vars
.env
.env.*
!.env.example

# Git
.git
.gitignore

# Editor / OS artefacts
.DS_Store
*.swp
*.swo
Thumbs.db

# Docker files themselves (entrypoint is intentionally NOT excluded — it must be COPYed into the image)
Dockerfile
docker-compose.yml
.dockerignore

# Logs
*.log
npm-debug.log*

# TypeScript build info (regenerated during build)
tsconfig.tsbuildinfo

# Demo / docs (not needed in production image)
demo-assets
README.md
